# ── Python bytecode / build artifacts ────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
.eggs/

# ── Virtual environments ─────────────────────────────────────────────
.venv/
venv/
env/
ENV/
.python-version

# ── Market data cache ────────────────────────────────────────────────
# MarketDataFetcher writes these relative to the CWD, so they turn up
# wherever the code is run from (repo root, analytics/, notebooks/).
cache/
**/cache/
*.parquet

# ── Notebooks ────────────────────────────────────────────────────────
.ipynb_checkpoints/
# Notebook *outputs* embed local paths, plots and portfolio figures.
# Strip outputs before committing (e.g. nbstripout) rather than
# ignoring notebooks wholesale.

# ── Real portfolio data ──────────────────────────────────────────────
# Broker exports are personal financial records and this repo is public.
# Put them here; nothing in it is ever committed.
private/

# ── Secrets / local config ───────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key
secrets.*
credentials.*

# ── Test / tooling caches ────────────────────────────────────────────
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/

# ── Editors / OS ─────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini
